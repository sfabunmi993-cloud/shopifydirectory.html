<script>


/* =====================================================
   CONTACT BUTTON
====================================================== */

function contactPartner() {

    alert(
        "Contact Fabunmi Samuel George"
    );

}



/* =====================================================
   SERVICE ACCORDION
====================================================== */

const services =
    document.querySelectorAll(".service");


services.forEach(service => {


    service.addEventListener(
        "click",
        function(event) {


            /*
             Don't toggle when clicking
             inside the description.
            */

            if (
                event.target.closest(
                    ".service-details"
                )
            ) {

                return;

            }


            const details =
                this.querySelector(
                    ".service-details"
                );


            if (!details) {

                return;

            }


            this.classList.toggle(
                "open"
            );


            const icon =
                this.querySelector(
                    ".minus"
                );


            if (icon) {

                if (
                    this.classList.contains(
                        "open"
                    )
                ) {

                    icon.textContent = "−";

                } else {

                    icon.textContent = "+";

                }

            }

        }
    );

